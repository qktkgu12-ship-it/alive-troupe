rules_version = '2';

// ALIVE 얼라이브 - Firestore 보안 규칙
// 핵심: 승인된 단원(member/admin)만 데이터 접근 가능. guest(대기)는 자기 문서 외 아무것도 못 봄.

service cloud.firestore {
  match /databases/{database}/documents {

    // 최초 관리자 이메일 (이 계정은 항상 관리자 권한 허용)
    function adminEmail() {
      return 'qktkgu12@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // 본인 user 문서에서 role 읽기
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == adminEmail() || myRole() == 'admin');
    }

    // 정단원 이상 (승인 완료)
    function isMember() {
      return isSignedIn() && (isAdmin() || myRole() == 'member');
    }

    // 해당 작품의 참여 단원인지 (작품 명단으로 접근 제어)
    function canAccessProduction(pid) {
      return pid != null
        && exists(/databases/$(database)/documents/productions/$(pid))
        && get(/databases/$(database)/documents/productions/$(pid)).data.participants is list
        && request.auth.uid in get(/databases/$(database)/documents/productions/$(pid)).data.participants;
    }

    // ---------- 회원 ----------
    match /users/{userId} {
      // 본인 문서 또는 관리자만 읽기 (명단·연락처는 관리자 전용)
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // 가입: 본인 문서만 생성 가능. 스스로 관리자/정단원으로 만들 수 없음
      // (관리자 이메일 계정은 예외적으로 admin 으로 생성 허용)
      allow create: if isSignedIn() && request.auth.uid == userId
        && (request.resource.data.role == 'guest'
            || request.auth.token.email == adminEmail());

      // 수정: 관리자는 전부 / 본인은 등급(role)은 못 바꾸고 프로필만 수정
      allow update: if isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.role == resource.data.role);

      // 삭제: 관리자만
      allow delete: if isAdmin();
    }

    // ---------- 공개 프로필 (단원끼리 보이는 이름·배역·기수·사진) ----------
    // 연락처 등 민감정보는 users 문서에만 두고(관리자 전용), 여기엔 넣지 않음
    match /publicProfiles/{userId} {
      allow read: if isMember();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ---------- 확정 일정 ----------
    match /events/{id} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();

      // 불참 의견 (문서 ID = 단원 uid)
      match /absences/{uid} {
        allow read: if isMember();
        allow create, update: if isMember()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isMember() && uid == request.auth.uid);
      }
    }

    // ---------- 예약 신청 (단원이 스튜디오 사용 신청 → 관리자가 확정) ----------
    // 단원은 본인 명의로만 신청/취소, 관리자는 확정(승격 후 삭제)·거절(삭제) 가능
    match /bookingRequests/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.requesterUid == request.auth.uid;
      allow delete: if isAdmin() || (isMember() && resource.data.requesterUid == request.auth.uid);
    }

    // ---------- 외부 손님 예약 (Apps Script가 네이버 예약 메일에서 넣음) ----------
    // 확정 일정에는 안 뜨지만, 일정방에서 스튜디오가 이미 잡혀 있음을 알리는 용도
    match /externalBookings/{id} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    // ---------- 개인 가능 일정 ----------
    match /availability/{id} {
      // 전체 가능 현황을 보려면 정단원 이상은 모두 읽기 가능
      allow read: if isMember();
      // 쓰기는 본인 것만 (데이터 uid + 문서ID 앞부분이 모두 본인이어야 함 → 남의 문서 덮어쓰기 방지)
      allow create, update: if isMember()
        && request.resource.data.uid == request.auth.uid
        && id.split('_')[0] == request.auth.uid;
      // 본인 것 삭제 가능 + 관리자는 단원 삭제 시 모두 정리 가능
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }

    // ---------- 일정 조율 카드 (카드별 가능일정) ----------
    match /coordinations/{cid} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.createdBy == request.auth.uid;
      // 수정/삭제: 만든 사람 또는 관리자 (확정 시 상태 변경 등)
      allow update, delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);

      // 이 카드에 대한 개인 가능일정 (문서 ID = 단원 uid, 본인 것만 쓰기)
      match /availability/{uid} {
        allow read: if isMember();
        allow create, update: if isMember()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isMember() && uid == request.auth.uid);
      }
    }

    // ---------- 아카이빙 ----------
    match /archives/{id} {
      // 관리자 전체 / 정단원은 참여 작품 자료만 (미지정 자료는 관리자만)
      allow read: if isAdmin() || (isMember() && canAccessProduction(resource.data.productionId));
      allow create: if isMember() && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || canAccessProduction(request.resource.data.productionId));
      // 수정: 관리자 전체 / 작성자 본인은 (작성자 변경 불가 + 참여 작품 내에서만)
      allow update: if isAdmin()
        || (isMember() && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && canAccessProduction(request.resource.data.productionId));
      // 삭제: 관리자 또는 작성자 본인
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    // ---------- 작품(음원·아카이빙 공용) ----------
    match /productions/{id} {
      // 관리자 전체 / 참여 단원만 (array-contains 쿼리와 호환되는 단순형)
      allow read: if isSignedIn()
        && (isAdmin() || request.auth.uid in resource.data.participants);
      allow create, update, delete: if isAdmin();
    }
    // 자료실 — 아카이브와 같은 규칙 (참여 단원이 올리고, 올린 사람이 고치고 지운다)
    match /audio/{id} {
      allow read: if isAdmin() || (isMember() && canAccessProduction(resource.data.productionId));
      allow create: if isMember() && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || canAccessProduction(request.resource.data.productionId));
      // 수정: 관리자 전체 / 올린 본인은 (올린이 변경 불가 + 참여 작품 내에서만)
      allow update: if isAdmin()
        || (isMember() && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && canAccessProduction(request.resource.data.productionId));
      // 삭제: 관리자 또는 올린 본인
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    // ---------- 게시판 ----------
    match /posts/{id} {
      allow read: if isMember();
      // 작성: 정단원 이상. 단, 공지(isNotice=true)는 관리자만
      allow create: if isMember()
        && request.resource.data.authorUid == request.auth.uid
        && (request.resource.data.isNotice == false || isAdmin());
      // 수정: 관리자 / 본인 글 / 또는 좋아요·댓글·조회수 카운트만 변경(전 단원)
      allow update: if isAdmin()
        || (isMember() && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.isNotice == false)
        || (isMember()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likeCount', 'commentCount', 'viewCount', 'updatedAt']));
      // 삭제: 관리자 또는 본인 글
      allow delete: if isAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);

      // 댓글 (1단계)
      match /comments/{cid} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);
      }

      // 투표 기록 (문서 ID = 단원 uid, 본인 것만 쓰기)
      match /votes/{uid} {
        allow read: if isMember();
        allow create, update: if isMember()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isMember() && uid == request.auth.uid);
      }
    }

    // 좋아요 (postLikes/{postId}_{uid})
    match /postLikes/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // 게시글 첨부 사진 (별도 저장 → 목록 경량화)
    // 하이재킹 방지: 같은 id의 '글 작성자'(또는 관리자)만 사진을 쓸 수 있음
    match /postMedia/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        || (isMember()
            && exists(/databases/$(database)/documents/posts/$(id))
            && get(/databases/$(database)/documents/posts/$(id)).data.authorUid == request.auth.uid);
      allow delete: if isAdmin()
        || (isMember() && resource.data.authorUid == request.auth.uid);

      // 본문 중간에 들어가는 사진 — 한 장에 문서 하나.
      // (한 문서에 몰아 담으면 서너 장에서 1MB 한도에 걸린다)
      // 글이 아직 없는 동안(작성 중 임시 저장)에도 올릴 수 있어야 하므로
      // 글 문서 대신 사진에 적힌 작성자로 판별한다.
      match /items/{mid} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAdmin()
          || (isMember() && resource.data.authorUid == request.auth.uid
              && request.resource.data.authorUid == resource.data.authorUid);
        allow delete: if isAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ---------- 푸시 알림 토큰 (문서 ID = FCM 토큰) ----------
    // 발송은 서버(Admin SDK)가 하므로 규칙을 건너뛴다. 여기선 단원이
    // 자기 기기의 토큰만 등록·해제할 수 있게만 열어 준다.
    match /fcmTokens/{token} {
      // 목록 조회는 서버만 하면 되므로 아무에게도 열지 않음
      allow read: if false;
      // 승인 대기(guest)도 '승인됐어요' 알림을 받으려면 토큰이 필요하다.
      // 대신 서버가 전체 발송 때 미승인자를 걸러내므로 공지가 새지 않는다.
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- 사이트 설정(테마) ----------
    match /settings/{id} {
      // 로그인 화면에서도 극단명·색을 보여주므로 읽기는 공개
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
